    "calc_metrics_bayes <- function(fit, test_data, model_name) {\n",
    "  \n",
    "  # Probabilidade posterior média\n",
    "  prob <- posterior_epred(\n",
    "    fit,\n",
    "    newdata = test_data\n",
    "  ) %>%\n",
    "    colMeans()\n",
    "  \n",
    "  # Classificação\n",
    "  class <- ifelse(\n",
    "    prob >= 0.5,\n",
    "    \"1\",\n",
    "    \"0\"\n",
    "  ) %>%\n",
    "    factor(\n",
    "      levels = levels(test_data$PD30)\n",
    "    )\n",
    "  \n",
    "  # Verdade\n",
    "  truth <- test_data$PD30\n",
    "  \n",
    "  calc_metrics_bay(\n",
    "    truth = truth,\n",
    "    class = class,\n",
    "    prob = prob\n",
    "  ) %>%\n",
    "    mutate(\n",
    "      wflow_id = model_name\n",
    "    )\n",
    "}"
   ]
  },
