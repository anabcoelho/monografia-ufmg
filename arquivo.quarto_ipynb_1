    "\n",
    "  fit <- eval.parent(substitute(fit_expr))\n",
    "\n",
    "  saveRDS(fit, path)\n",
    "\n",
    "  message(\"Modelo salvo em: \", path)\n",
    "\n",
    "  fit\n",
    "}"
