      },
      "source": [
        "wf_logit <- workflow_set(\n",
        "  preproc = list(\n",
        "    all_features = rec_all,\n",
        "    score_only   = rec_score_only,\n",
        "    #score_prazo  = rec_score_prazo,\n",
        "    no_score     = rec_no_score,\n",
        "    no_corr      = rec_no_corr\n",
        "    #pca          = rec_pca\n",
        "  ),\n",
        "  models = list(\n",
        "    logit = log_glm\n",
        "  )\n",
        ")\n",
        "\n",
        "wf_l1 <- workflow() %>%\n",
        "  add_recipe(rec_def) %>%\n",
        "  add_model(log_l1)\n",
        "\n",
        "tuned_l1 <- tune_grid(\n",
        "  wf_l1,\n",
        "  resamples = folds,\n",
        "  grid = grid,\n",
        "  metrics = metrics\n",
        ")\n",
        "\n",
        "wf_l2 <- workflow() %>%\n",
        "  add_recipe(rec_def) %>%\n",
        "  add_model(log_l2)\n",
        "\n",
        "tuned_l2 <- tune_grid(\n",
        "  wf_l2,\n",
        "  resamples = folds,\n",
        "  grid = grid,\n",
        "  metrics = metrics\n",
        ")"
